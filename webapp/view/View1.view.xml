<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" 
          controllerName="ey.sd.sls.controller.View1">
    <Page title="View 1">
        <headerContent>
            <Button icon="sap-icon://action" tooltip="Go to next" press="onNext"></Button>
        </headerContent>
        <content>
            <SearchField id="idSearch" search="onSearch"></SearchField>
            <List id="idList" items="{/ProductSet}" growing="true" growingThreshold="10" selectionChange="onItemPress" mode="SingleSelectMaster"
             delete="onDeleteItem">
             <headerToolbar>
                <Toolbar>
                  <ToolbarSpacer></ToolbarSpacer>
                  <Button icon="sap-icon://delete" press="onMultiDelete"></Button>
                </Toolbar>
             </headerToolbar>
                <items>
                    <ObjectListItem title="{PRODUCT_ID}" type="Navigation"
                    intro="{DESCRIPTION}" 
                    number="{PRICE}" numberUnit="{CURRENCY_CODE}"
                    icon="sap-icon://product">
                        <attributes>
                            <ObjectAttribute text="{CATEGORY}" title="Type"></ObjectAttribute>
                        </attributes>
                        <firstStatus>
                            <ObjectStatus text="{path : 'SUPPLIER_NAME'
                            }"></ObjectStatus>
                        </firstStatus>
                    </ObjectListItem>
                </items>
            </List>
            <!-- <Button id="idBtnNext" text="Next" press="onNext"/> -->
        </content>
        <footer>
          <Toolbar >
              <ToolbarSpacer></ToolbarSpacer>
                <Button icon="sap-icon://add" press="onAdd"/>
          </Toolbar>
        </footer>
    </Page>
</mvc:View>